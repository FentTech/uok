# Supabase Configuration
# Get these values from your Supabase project dashboard

# Your Supabase Project URL
# Found in: Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Key (public key)
# Found in: Settings → API → Project API keys → anon (public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Project-owned TURN server (comma-separated URLs). Use short-lived credentials in production.
# Example URLs: turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Note: Never commit .env.local to git
# Copy this file to .env.local and fill in your actual values
